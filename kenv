APP_NAME=VendorPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Scheduler: use `php artisan schedule:work` locally, OS cron `* * * * * php artisan schedule:run` in production,
# or the `scheduler` service when using docker-compose.yml in this repo.

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use a database name dedicated to VendorPulse only (e.g. vendorpulse). Never use exportdoc here.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54321
DB_DATABASE=vendorpulse
DB_USERNAME=vendorpulse
DB_PASSWORD=vendorpulse

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

# Redis client: phpredis (PECL `redis` extension — required for this project default). Install for the same PHP CLI you use for `php artisan` (e.g. `pecl install redis`). Optional: set to `predis` and run `composer require predis/predis` if you cannot install the extension.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated origins for the Next.js web dashboard (CORS + credentials).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:7357,http://127.0.0.1:7357

# Sanctum SPA domains (Next dev server). Add production dashboard host when deployed.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# --- Site monitoring (Laravel scheduler + Horizon) ---
# Run: php artisan schedule:work (or OS cron -> schedule:run) and php artisan horizon
SITE_MONITORING_QUEUE=site-monitoring
SITE_MONITORING_DOMAIN_PROVIDER=rdap
SITE_MONITORING_UPTIME_HTTP_RETRIES=3
SITE_MONITORING_RUN_JOB_TRIES=3
SITE_MONITORING_RUN_JOB_BACKOFF=15,60,180
SITE_MONITORING_DISPATCH_JOB_TRIES=3
SITE_MONITORING_DISPATCH_JOB_BACKOFF=30,120
SITE_MONITORING_HTTP_LOG_BODY_MAX_BYTES=4096

