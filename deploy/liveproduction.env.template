APP_NAME=VendorPulse
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://vendorpulse.veravalonline.com

# Host bind port for Laravel app container (${APP_PORT}:8000 in docker-compose.yml).
# Set to a free host port when 8000 is already used (example: 8001).
APP_PORT=8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (use dedicated VendorPulse DB, not exportdoc).
# If DB runs in same compose stack, keep DB_HOST=postgres and DB_PORT=5432.
# If DB runs on host/managed instance, set host/port accordingly.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vendorpulse
DB_USERNAME=vendorpulse
DB_PASSWORD=

# Sessions / cache / queue
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=vendorpulse.veravalonline.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_QUEUE_RETRY_AFTER=360

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@vendorpulse.veravalonline.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web dashboard + API same-origin production settings
WEB_DASHBOARD_URL=https://vendorpulse.veravalonline.com
NEXT_PUBLIC_API_URL=https://vendorpulse.veravalonline.com/api/v1
NEXTAUTH_URL=https://vendorpulse.veravalonline.com
NEXTAUTH_SECRET=

CORS_ALLOWED_ORIGINS=https://vendorpulse.veravalonline.com
SANCTUM_STATEFUL_DOMAINS=vendorpulse.veravalonline.com

SITE_MONITORING_QUEUE=site-monitoring
SITE_MONITORING_DOMAIN_PROVIDER=rdap
SITE_MONITORING_UPTIME_HTTP_RETRIES=3
SITE_MONITORING_RUN_JOB_TRIES=3
SITE_MONITORING_RUN_JOB_BACKOFF=15,60,180
SITE_MONITORING_DISPATCH_JOB_TRIES=3
SITE_MONITORING_DISPATCH_JOB_BACKOFF=30,120
SITE_MONITORING_HTTP_LOG_BODY_MAX_BYTES=4096

# Set this to the real Node binary on the production runner.
EXPERIENCE_MONITORING_RUNNER_COMMAND=/usr/local/bin/node
EXPERIENCE_MONITORING_RUNNER_TIMEOUT_SECONDS=300

